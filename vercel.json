{
  "headers": [
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-store, max-age=0" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store" } ] }
  ],
  "crons": [ { "path": "/api/push/tick", "schedule": "0 * * * *" } ]
}
